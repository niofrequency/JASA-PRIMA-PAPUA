  "dependencies": {
    "@google/genai": "^2.15.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "firebase": "^10.12.5",
    "firebase-admin": "^14.1.0",
    "lucide-react": "^0.440.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@vercel/node": "^5.8.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
